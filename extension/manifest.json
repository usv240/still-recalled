{
  "manifest_version": 3,
  "name": "Still Recalled",
  "version": "0.6.0",
  "description": "Flags secondhand listings that look like a recalled product or a risky baby sleep product.",
  "key": "",
  "minimum_chrome_version": "139",
  "permissions": [
    "sidePanel",
    "storage",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.ebay.com/*",
    "https://*.ebayimg.com/*",
    "https://*.mercari.com/*",
    "https://*.mercdn.net/*",
    "https://*.craigslist.org/*",
    "https://*.facebook.com/marketplace/*",
    "https://*.fbcdn.net/*",
    "https://www.saferproducts.gov/*",
    "https://www.cpsc.gov/*",
    "http://localhost:8766/*"
  ],
  "background": {
    "service_worker": "build/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Still Recalled",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ebay.com/*",
        "https://*.mercari.com/*",
        "https://*.craigslist.org/*",
        "https://*.facebook.com/marketplace/*"
      ],
      "js": [
        "build/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*.ebay.com/*",
        "https://*.mercari.com/*",
        "https://*.craigslist.org/*",
        "https://*.facebook.com/*"
      ]
    }
  ]
}
